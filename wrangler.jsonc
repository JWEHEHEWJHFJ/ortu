{
  // GANTI "name" agar SAMA PERSIS dengan nama proyek di Cloudflare (Workers & Pages > proyek kamu)
  "name": "ortu",
  "main": "worker/index.js",
  // >= 2025-04-01: navigasi browser ke path yang tidak ada dijawab 404.html TANPA memanggil Worker
  "compatibility_date": "2025-04-01",
  // build otomatis dijalankan saat `wrangler deploy` (jadi kolom Build command di dashboard boleh kosong)
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    // Path tidak ditemukan -> dist/404.html (static, tidak dihitung)
    "not_found_handling": "404-page",
    // HANYA path ini yang menjalankan Worker (= 1 hitungan "Requests today" per buka aplikasi).
    // JANGAN tambahkan "/", "/app.*", "/data/*" di sini: setiap path yang ditambahkan
    // akan ikut dihitung lagi setiap kali halaman dibuka.
    "run_worker_first": ["/sp5p-cfg.js"]
  },
  // decoy = kirim config sampah ke scraper | block = 403 | off = matikan proteksi
  "vars": { "PROTECT_MODE": "decoy" }
}
